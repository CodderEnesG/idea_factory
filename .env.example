# ── Analist sağlayıcı ──────────────────────────────────────────────
# MVP = gemini (ucuz). Claude sonrası için: ANALYSIS_PROVIDER=anthropic
ANALYSIS_PROVIDER=gemini

# Gemini (MVP) — iki mod:
# (a) Developer API (AI Studio): https://aistudio.google.com/apikey — AIza... key
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash        # erişim yoksa gemini-2.5-flash yaz
# (b) Vertex AI (GCP, $300 kredi kapsar): ADC auth (gcloud application-default login)
GEMINI_USE_VERTEX=false              # true → Vertex; project+location gerekir, API key yok sayılır
GOOGLE_CLOUD_PROJECT=idea-factory-502619
GOOGLE_CLOUD_LOCATION=us-central1

# Anthropic (sonra / faz 2)
ANTHROPIC_API_KEY=sk-ant-...
ANALYSIS_MODEL=claude-opus-4-8

# ── Grounding (canlı web araması) ──────────────────────────────────
# Hangi merceğin arama yaptığı artık DB'de: `lenses.grounding` (migration 0015).
# Beyaz-alan AÇIK (satırlarının %66'sı confidence:low idi — "TR'de kaç oyuncu var" sorusu
# aramasız cevaplanamıyor), arbitraj KAPALI (2026-08-19 pilotu zarar gösterdi).
# Bu değişken global kill-switch: false ise hiçbir mercekte arama yapılmaz.
# Sinyal başına GROUNDING_QUERIES kadar ek LLM çağrısı — yalnız grounding açık merceklerde.
GROUNDING_ENABLED=false
# GROUNDING_MODEL=gemini-3.5-flash   # boşsa GEMINI_MODEL'i kullanır
# GROUNDING_TIMEOUT_MS=30000         # SORGU BAŞINA; sorgular paralel, duvar saati ~1x
# GROUNDING_QUERIES=3                # TR taraması + TR/MENA (İngilizce) + fonlama momentumu

# ── LLM zaman bütçeleri (FAZ6_PLAN.md §Faz 1.1) ────────────────────
# Timeout'suz bir çağrı asılan bağlantıda tick'i sonsuza kadar bekletiyordu; cron.ts'in
# `running` guard'ı da kalıcı kilitlenip pipeline'ı sessizce öldürüyordu.
# LLM_TIMEOUT_MS=90000               # tek HTTP çağrısı tavanı
# ANALYZE_DEADLINE_MS=240000         # bir sinyalin tüm guard-retry döngüsü (4 çağrıya kadar)
# DEBATE_DEADLINE_MS=300000          # bir tartışmanın 7 turu + moderatör

# ── Enrichment (sinyal zenginleştirme — hepsi opsiyonel, kod default'lu) ──
ENRICH_LIMIT=25            # tick başına; backfill için 200
ENRICH_CONCURRENCY=2       # Vertex burst 429 görüldü — 3'ü aşma
ENRICH_MAX_CHARS=18000
ENRICH_FETCH_TIMEOUT_MS=15000
# FORCE_ENRICH=true        # zaten zenginleşmişleri de yeniden işle

# ── Supabase (Project Settings → API) ──────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Web auth (apps/web) — per-user hafif login ─────────────────────
# AUTH_SECRET set edilince: login sayfası + imzalı cookie session; her karar/yorum gerçek
# kullanıcıyla damgalanır. Boşsa auth kapalı (lokal dev / demo — uygulama açık).
# Public URL'de MUTLAKA güçlü rastgele bir değer set et: openssl rand -hex 32
# AUTH_SECRET=degistir-guclu-rastgele-32-bayt
#
# Üye ekle (parola düz metin DB'ye girmez, scrypt hash):
#   pnpm --filter @idea-factory/web add-member <username> <display_name> <password>

# ── Cron (apps/worker: pnpm cron — uzun ömürlü zamanlayıcı) ──────────────
# CRON_SCHEDULE=0 7,19 * * *   # varsayılan: her gün 07:00 ve 19:00
# CRON_TZ=Europe/Istanbul
# CRON_RUN_ON_START=true       # başlar başlamaz bir tick koş
