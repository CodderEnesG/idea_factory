{
  "name": "idea-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Thesis-driven venture & market intelligence — v1 MVP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "ingest": "pnpm --filter @idea-factory/worker ingest",
    "enrich": "pnpm --filter @idea-factory/worker enrich",
    "analyze": "pnpm --filter @idea-factory/worker analyze",
    "digest": "pnpm --filter @idea-factory/worker digest",
    "tick": "pnpm --filter @idea-factory/worker tick",
    "eval": "pnpm --filter @idea-factory/core eval",
    "web": "pnpm --filter @idea-factory/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^20.17.6"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
